// dn-site — Workers static-assets deploy of the docneural site.
// Canonical host: https://docneural.khalidrafi.tech (custom domain, zone on same CF account).
// Fallback mirror: https://dn-site.khalidrafi.workers.dev
// Deploy: CLOUDFLARE_API_TOKEN=… CLOUDFLARE_ACCOUNT_ID=… npx wrangler deploy
{
  "name": "dn-site",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    { "pattern": "docneural.khalidrafi.tech", "custom_domain": true }
  ]
}
